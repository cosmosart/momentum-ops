# ─────────────────────────────────────────────────────────────────────────────
# .env.template — Copy to .env on each host and fill in values
#
# Variables marked [ALL] are needed on every host.
# Variables marked with a specific host are only needed there.
# ─────────────────────────────────────────────────────────────────────────────

# ── [ALL] App PostgreSQL connection (points to db-server) ─────────────────
DB_HOST=<db-server-ip>
DB_PORT=5432
DB_NAME=momentum_db
DB_USER=momentum_user
DB_PASSWORD=<strong-password>

# ── [db-server] PostgreSQL data dir (optional, defaults to named volume) ──
# POSTGRES_DATA_PATH=/data/postgres

# ── [prefect-server] Prefect metadata DB ──────────────────────────────────
PREFECT_DB_PASSWORD=<strong-prefect-db-password>

# ── [prefect-server] Prefect API URL (internal & external) ────────────────
# Workers on the same host use the internal URL:
PREFECT_API_URL=http://<prefect-server-ip>:4200/api

# ── [prefect-server] Model artifacts path (read by worker) ───────────────
MODEL_ARTIFACTS_HOST_PATH=/opt/momentum-ops/model_artifacts

# ── [dashboard-server] (reads DB_* and DEFAULT_TICKER) ───────────────────
DEFAULT_TICKER=AAPL

# ── [ml-server] Model artifacts output dir ────────────────────────────────
ML_MODEL_ARTIFACTS_PATH=/opt/momentum-ops/model_artifacts

# ── [ml-server] GPU device (set to cpu if no NVIDIA GPU) ─────────────────
# NVIDIA_VISIBLE_DEVICES=all
