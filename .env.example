# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=momentum_db
DB_USER=momentum_user
DB_PASSWORD=momentum_password

# Application Configuration
DEFAULT_TICKER=AAPL
UPDATE_INTERVAL_MINUTES=5

# Scheduler Configuration
SCHEDULER_TIMEZONE=UTC

# Model Artifacts — host path bind-mounted into containers
# Set this to the directory where trained XGBoost JSON files are stored.
MODEL_ARTIFACTS_HOST_PATH=/path/to/your/model_artifacts

# Remote Deployment (used by scripts/deploy.sh and scripts/build_and_upload.sh)
DEPLOY_USER=your_user
DEPLOY_HOST=your_server_ip
DEPLOY_APP_DIR=/path/to/remote/app
DEPLOY_MODEL_DIR=/path/to/remote/models
