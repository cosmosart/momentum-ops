# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Environment variables for momentum-ops
#
# Copy to .env and fill in values:   cp .env.example .env
#
# For production per-host deployment, see infrastructure/deploy/.env.template
# ─────────────────────────────────────────────────────────────────────────────

# ── App PostgreSQL ────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=momentum_db
DB_USER=momentum_user
DB_PASSWORD=momentum_password

# ── Prefect ───────────────────────────────────────────────────────────────
PREFECT_API_URL=http://prefect:4200/api
# URL the Prefect web UI (browser) uses to reach the API.
# For local dev: http://localhost:4200/api
# For remote:    http://<prefect-server-ip>:4200/api
PREFECT_UI_API_URL=http://localhost:4200/api

# ── Application ───────────────────────────────────────────────────────────
DEFAULT_TICKER=AAPL
SCHEDULER_TIMEZONE=Asia/Tokyo
UPDATE_INTERVAL_MINUTES=5
MIN_HISTORY_ROWS=60

# ── API Keys (optional) ──────────────────────────────────────────────────
# FMP_API_KEY=your_fmp_api_key
# OPENAI_API_KEY=your_openai_api_key

# ── Model Artifacts ──────────────────────────────────────────────────────
# Host path bind-mounted into worker / dashboard / ML containers.
MODEL_ARTIFACTS_HOST_PATH=/path/to/your/model_artifacts
# In-container path used by shared/config.py (default: model_artifacts)
# MODEL_ARTIFACTS_DIR=model_artifacts

# ── Remote Deployment (scripts/deploy.sh, scripts/build_and_upload.sh) ───
DEPLOY_USER=your_user
DEPLOY_HOST=your_server_ip
DEPLOY_APP_DIR=/path/to/remote/app
DEPLOY_MODEL_DIR=/path/to/remote/models

# ── ML Server (docker-compose.ml.yml) ────────────────────────────────────
# ML_MODEL_ARTIFACTS_PATH=/opt/momentum-ops/model_artifacts
# NVIDIA_VISIBLE_DEVICES=all

